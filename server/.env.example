# ==========================================
# Feishu Voice Device - Configuration Template
# ==========================================

# 飞书自建应用凭据 (进入飞书开放平台 open.feishu.cn -> 企业自建应用 -> 凭证与基础信息 获取)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认绑定的飞书用户 open_id (可选。如留空，任何用户首次给机器人发消息即自动绑定为接收者)
DEFAULT_OPEN_ID=

# 服务监听配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
